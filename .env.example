# =============================================
# Booth Clone — Environment Variables
# =============================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 初期管理者（entrypointで自動作成。未設定なら作成しない）
# 本番では必ず強力なパスワードを設定し、作成後に変更すること
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# PostgreSQL (Docker)
PGDATABASE=booth
PGUSER=booth
PGPASSWORD=booth_secret_2026
PGHOST=db
PGPORT=5432
DATABASE_URL=postgres://booth:booth_secret_2026@db:5432/booth

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Set to "True" to run tasks synchronously (no Redis needed for dev)
CELERY_TASK_ALWAYS_EAGER=True

# Email (Postfix SMTP — unset for console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# For local dev without SMTP:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=postfix
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@booth.local

# Port mapping (Docker)
PORT=8000

# Postfix relay (for production email delivery)
POSTFIX_RELAYHOST=
POSTFIX_MAILNAME=booth.local

# =============================================
# Stripe（手数料あり決済 — 無料で利用可能）
# 取得先: https://dashboard.stripe.com/apikeys
# Webhook: https://dashboard.stripe.com/webhooks
# =============================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================
# PayPal（手数料あり決済 — 無料で利用可能）
# 取得先: https://developer.paypal.com/dashboard/applications
# =============================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 開発中はTrue（サンドボックス環境でテスト）
PAYPAL_SANDBOX=False

# =============================================
# S3互換ストレージ（完全無料の選択肢）
# 推奨: Cloudflare R2  — 10GB無料・エグレス無料
#        https://dash.cloudflare.com → R2
# 代替: Backblaze B2   — 10GB無料
#        https://www.backblaze.com/cloud-storage
# 代替: MinIO          — 自己ホストで完全無料
# =============================================
# ローカル保存の場合は False のまま
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=booth-media
# Cloudflare R2の例: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Backblaze B2の例:  https://s3.<REGION>.backblazeb2.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_SIGNATURE_VERSION=s3v4
